<view class="page">

  <canvas type="2d" id="mapCanvas" class="map-canvas" disable-scroll
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtouchcancel="onTouchCancel" />

  <!-- 顶部 HUD -->
  <view class="hud">
    <view wx:if="{{level === 'province'}}" class="chip back" bindtap="onBack">‹ 全国</view>
    <view class="chip title">{{currentName}}</view>
    <view class="chip routes" bindtap="onOpenRoutes">路线</view>
    <view class="chip list" bindtap="onOpenList">清单</view>
    <view class="chip my" bindtap="onOpenMy">
      <image class="my-icon" src="/assets/tab/my.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 操作提示 -->
  <view class="hint" wx:if="{{level === 'country' && showHint && !routeSelect}}">单击省份标记 · 弹层内可查看市界</view>
  <view class="hint hint-select" wx:if="{{routeSelect && level === 'country'}}">点省份进入选市 · 无下级地区直接成站</view>
  <view class="hint hint-select" wx:if="{{routeSelect && level === 'province'}}">点选城市加入路线 · 再点一次移除 · 点「‹ 全国」换省</view>

  <!-- 图例（可点，兼作筛选器；选点模式下隐藏避免与选点条重叠） -->
  <view class="legend" wx:if="{{!routeSelect}}">
    <view class="legend-item {{filter === 'all' ? 'on' : ''}}" data-f="all" bindtap="onFilter">
      <view class="swatch s-plain"></view>
      <text>全部</text>
    </view>
    <view class="legend-item {{filter === 'visited' ? 'on' : ''}}" data-f="visited" bindtap="onFilter">
      <view class="swatch s-visited"></view>
      <text>去过 {{stats.visited}}</text>
    </view>
    <view class="legend-item {{filter === 'want' ? 'on' : ''}}" data-f="want" bindtap="onFilter">
      <view class="swatch s-want"></view>
      <text>想去 {{stats.want}}</text>
    </view>
  </view>

  <!-- 加载进度条 -->
  <view class="loadbar" wx:if="{{loading}}">
    <view class="loadbar-inner" style="width:{{progress}}%"></view>
    <text class="loadbar-text">{{loadingText}}</text>
  </view>

  <!-- 错误提示 -->
  <view class="error-tip" wx:if="{{error}}" bindtap="onRetry">{{error}}</view>

  <!-- 标记弹层 -->
  <!-- 遮罩与弹层为兄弟节点：滚动区上方不能有 catchtouchmove 祖先，
       真机（尤其 iOS）上祖先 catch 拦截会卡死内部滚动 -->
  <view wx:if="{{sheet}}" class="sheet-mask" bindtap="closeSheet" catchtouchmove="noop"></view>
  <view wx:if="{{sheet}}" class="sheet" catchtap="noop">
    <view class="sheet-title">
      <text>{{sheet.name}}</text>
      <text wx:if="{{sheet.status === 'want'}}" class="plan-tag">计划</text>
    </view>
    <view class="sheet-sub text-dim">{{sheet.levelLabel}} · {{sheet.adcode}}</view>
    <view class="sheet-btns">
      <view class="sheet-btn s-visited-btn {{sheet.status === 'visited' ? 'on' : ''}}"
            data-status="visited" bindtap="onPickStatus">去过</view>
      <view class="sheet-btn s-want-btn {{sheet.status === 'want' ? 'on' : ''}}"
            data-status="want" bindtap="onPickStatus">想去</view>
      <view class="sheet-btn s-clear-btn {{!sheet.status ? 'on' : ''}}"
            data-status="" bindtap="onPickStatus">清除</view>
    </view>
    <view class="sheet-drill" wx:if="{{sheet.canDrill}}" bindtap="onDrill">
      <text>查看市界</text>
      <text class="sheet-drill-arrow">›</text>
    </view>

    <!-- 可滚动区：回忆 + 推荐（弹层限高 85%，超出在此滚动）。
         用普通 view + CSS 滚动，不用 scroll-view：真机上 scroll-view 在
         max-height 弹层内高度推导不可靠，普通 div 是浏览器原生行为 -->
    <view class="sheet-body">
      <!-- 我的回忆（排在景点推荐之前：我经历了什么 > 这里有什么可看） -->
      <view class="mems">
          <view class="mems-head">
            <text class="mems-title">我的回忆</text>
            <text wx:if="{{sheet.memCount}}" class="mems-count text-dim">{{sheet.memCount}} 条 · {{sheet.memPhotos}} 张</text>
          </view>

          <view wx:if="{{sheet.memCount}}" class="mems-body" bindtap="onOpenMemory">
            <view class="mems-thumbs">
              <image wx:for="{{sheet.memThumbs}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="mems-thumb" />
            </view>
            <view class="mems-go">查看全部<text class="mems-arrow">›</text></view>
          </view>

          <view wx:else class="mems-empty" bindtap="onOpenMemory">
            <text class="mems-plus">+</text>
            <text class="mems-empty-text">{{sheet.status === 'want' ? '为这趟计划写点期待' : '写下这次旅行'}}</text>
          </view>
        </view>

        <!-- 当地景点推荐 -->
        <view class="spots">
          <view class="spots-head">
            <text class="spots-title">当地推荐</text>
            <!-- @dev:begin -->
            <text class="spots-more {{sheet.spotsLoading ? 'loading' : ''}}"
                  bindtap="onGenAttractions">{{sheet.spotsLoading ? '生成中…' : 'AI 补充'}}</text>
            <!-- @dev:end -->
          </view>
          <view wx:if="{{!sheet.spotsLoading && sheet.spots.length === 0}}" class="spots-empty text-dim">
            暂无推荐
          </view>
          <view wx:for="{{sheet.spots}}" wx:key="name" class="spot">
            <image wx:if="{{item.img}}" class="spot-img" src="{{item.img}}" mode="aspectFill" />
            <view wx:else class="spot-img spot-img-ph">{{item.name[0]}}</view>
            <view class="spot-body">
              <view class="spot-line1">
                <text class="spot-name">{{item.name}}</text>
                <text class="spot-season">{{item.bestMonths || '四季皆宜'}}</text>
              </view>
              <view class="spot-desc text-dim">{{item.desc}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="sheet-hint text-dim">{{sheet.hint}}</view>
  </view>

  <!-- 路线列表弹层（与标记弹层同款结构：遮罩与弹层为兄弟节点） -->
  <view wx:if="{{routeSheet}}" class="sheet-mask" bindtap="closeRouteSheet" catchtouchmove="noop"></view>
  <view wx:if="{{routeSheet}}" class="sheet" catchtap="noop">
    <view class="sheet-title">路线</view>
    <view class="sheet-sub text-dim">把去过和想去的城市连成行程</view>
    <view class="route-new" bindtap="onCreateRoute">+ 新建路线</view>

    <view class="sheet-body">
      <view wx:if="{{routeSheet.routes.length === 0}}" class="route-empty text-dim">
        还没有路线，点上方「新建路线」开始
      </view>
      <view wx:for="{{routeSheet.routes}}" wx:key="id" class="route-item">
        <view class="route-info" bindtap="onToggleRoute" data-id="{{item.id}}">
          <view class="route-line1">
            <text class="route-name">{{item.name}}</text>
            <text wx:if="{{item.hidden}}" class="route-tag">已隐藏</text>
            <text wx:elif="{{item.status === 'done'}}" class="route-tag route-tag-done">已走完</text>
            <text wx:else class="route-tag route-tag-plan">规划中</text>
          </view>
          <view class="route-path text-dim">{{item.path}}</view>
          <view class="route-meta text-dim">{{item.count}} 城 · 直线约 {{item.km}} km · 点击{{item.hidden ? '显示' : '隐藏'}}</view>
        </view>
        <view class="route-del" catchtap="onDeleteRoute" data-id="{{item.id}}">删除</view>
      </view>
    </view>
  </view>

  <!-- 新建路线选点条：不遮挡地图，地图可继续拖拽缩放与点选 -->
  <view wx:if="{{routeSelect}}" class="select-bar" catchtap="noop">
    <input class="select-name" value="{{routeSelect.name}}" placeholder="路线名称"
           placeholder-class="select-name-ph" bindinput="onRouteName" />
    <scroll-view class="select-stops" scroll-x enable-flex>
      <view wx:for="{{routeSelect.stops}}" wx:key="_k" class="select-chip"
            data-i="{{index}}" catchtap="onRemoveStop">
        <text class="select-chip-idx">{{index + 1}}</text>
        <text class="select-chip-name">{{item.name}}</text>
        <text class="select-chip-x">×</text>
      </view>
      <view wx:if="{{routeSelect.stops.length === 0}}" class="select-stops-empty text-dim">还没选城市</view>
    </scroll-view>
    <view class="select-btns">
      <view class="select-cancel" bindtap="onCancelRoute">取消</view>
      <view wx:if="{{routeSelect.stops.length >= 2}}" class="select-loop" bindtap="onCloseLoop">{{routeSelect.closed ? '取消闭合' : '闭合环线'}}</view>
      <view class="select-done" bindtap="onFinishRoute">完成（{{routeSelect.stops.length}}）</view>
    </view>
  </view>
</view>
