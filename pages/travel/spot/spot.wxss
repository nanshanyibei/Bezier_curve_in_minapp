/* 景区详情页：深色底，卡片沿用全局 .card */

.spot {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* ---------- 主图 ---------- */
.hero {
  position: relative;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-nature {
  background: linear-gradient(150deg, #1d3b33 0%, #24504a 45%, #16161c 100%);
}

.hero-culture {
  background: linear-gradient(150deg, #33283f 0%, #4a3355 45%, #16161c 100%);
}

.hero-mixed {
  background: linear-gradient(150deg, #223047 0%, #2f3f5c 45%, #16161c 100%);
}

.hero-ph {
  font-size: 160rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.18);
  letter-spacing: 8rpx;
}

/* 主图授权署名（CC BY / CC BY-SA 要求） */
.hero-credit {
  position: absolute;
  right: 12rpx;
  bottom: 8rpx;
  max-width: 92%;
  font-size: 18rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.72);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.6);
  text-align: right;
}

/* ---------- 标题区 ---------- */
.head {
  padding: 32rpx 36rpx 0;
}

.head-name {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--text);
}

.head-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.badge {
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  color: var(--text-dim);
  background: var(--bg-card-2);
}

.badge-5a {
  color: #16161c;
  background: var(--orange);
  font-weight: 700;
}

.head-dot {
  color: var(--border);
  margin: 0 2rpx;
}

.head-sub {
  font-size: 22rpx;
  color: var(--text-dim);
}

.oneline {
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: var(--accent);
}

/* ---------- 去过 / 想去 ---------- */
.acts {
  display: flex;
  gap: 16rpx;
  padding: 28rpx 36rpx 4rpx;
}

.act {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 27rpx;
  color: var(--text-dim);
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
}

.act-on {
  color: var(--green);
  background: rgba(126, 212, 145, 0.12);
  border-color: rgba(126, 212, 145, 0.4);
}

.act-ico {
  font-size: 26rpx;
}

/* ---------- 标签 ---------- */
.tagline {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 24rpx 36rpx 8rpx;
}

.tag {
  font-size: 22rpx;
  color: var(--accent);
  background: var(--accent-soft);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

/* ---------- 内容卡片 ---------- */
.card {
  margin: 20rpx 36rpx;
}

.hl {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 10rpx 0;
}

.hl-i {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  background: var(--bg-card-2);
  color: var(--accent);
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
}

.hl-t {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--text);
}

.intro {
  font-size: 27rpx;
  line-height: 1.75;
  color: var(--text);
}

.row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.row:last-child {
  border-bottom: none;
}

.row-k {
  flex: none;
  width: 80rpx;
  font-size: 24rpx;
  color: var(--text-dim);
}

.row-v {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text);
}

.card-tip {
  border-color: rgba(240, 179, 94, 0.28);
  background: rgba(240, 179, 94, 0.06);
}

/* ---------- 空态与脚注 ---------- */
.spot-none {
  margin: 24rpx 36rpx;
  padding: 28rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--text-dim);
  background: var(--bg-card);
  border: 1rpx dashed var(--border);
  border-radius: 16rpx;
}

.spot-empty {
  padding: 200rpx 60rpx;
  text-align: center;
  color: var(--text-dim);
  font-size: 27rpx;
}

.foot {
  margin: 36rpx 36rpx 0;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--text-dim);
  opacity: 0.8;
  text-align: center;
}
