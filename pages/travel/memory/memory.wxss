.mem-page {
  padding: 28rpx 28rpx 0;
  box-sizing: border-box;
}

/* 城市头 */
.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.head-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.head-city {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text);
}

.head-stat {
  font-size: 22rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.5;
}

.tag-visited {
  color: var(--green);
  background: rgba(126, 212, 145, 0.14);
}

.tag-plan {
  color: var(--orange);
  background: rgba(240, 179, 94, 0.14);
}

/* 时间轴 */
.entry {
  display: flex;
  gap: 20rpx;
}

.date-col {
  flex: 0 0 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.date-badge {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.date-day {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.1;
}

.date-month {
  font-size: 20rpx;
  color: var(--text-dim);
  line-height: 1.2;
}

.date-line {
  flex: 1;
  width: 2rpx;
  background: var(--border);
  margin: 12rpx 0;
}

.entry-body {
  flex: 1;
  min-width: 0;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 28rpx;
}

.entry-meta {
  font-size: 22rpx;
  display: flex;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.dot {
  opacity: 0.6;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 10rpx;
  line-height: 1.45;
}

.entry-text {
  font-size: 28rpx;
  color: #cfcfd8;
  line-height: 1.7;
  /* 4 行截断 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
  word-break: break-all;
}

/* 九宫格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.cell {
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--bg-card-2);
}

.cell-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cell-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--text-dim);
}

.grid-1 .cell {
  width: 100%;
  height: 400rpx;
}

.grid-2 .cell {
  width: calc(50% - 6rpx);
  height: 220rpx;
}

.grid-3 .cell {
  width: calc(33.33% - 8rpx);
  height: 150rpx;
}

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 60rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #16161c;
  font-size: 28rpx;
  font-weight: 600;
}

/* 悬浮添加 */
.bottom-space {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 34rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #16161c;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(110, 168, 254, 0.35);
}

.fab-plus {
  font-size: 34rpx;
  line-height: 1;
}
