.edit-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.body {
  flex: 1;
  padding: 28rpx 28rpx 0;
  box-sizing: border-box;
}

/* 城市条 */
.city-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.city-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.5;
}

.tag-visited {
  color: var(--green);
  background: rgba(126, 212, 145, 0.14);
}

.tag-plan {
  color: var(--orange);
  background: rgba(240, 179, 94, 0.14);
}

/* 字段 */
.field {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.field-text {
  position: relative;
  padding-bottom: 48rpx;
}

.label {
  font-size: 24rpx;
  color: var(--text-dim);
  display: block;
  margin-bottom: 12rpx;
}

.picker-val {
  font-size: 30rpx;
  color: var(--text);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  color: var(--text-dim);
  font-size: 32rpx;
}

.inp-title {
  font-size: 32rpx;
  color: var(--text);
  width: 100%;
  height: 56rpx;
  line-height: 56rpx;
}

.inp-text {
  font-size: 30rpx;
  color: var(--text);
  width: 100%;
  min-height: 240rpx;
  line-height: 1.7;
}

.ph {
  color: var(--text-dim);
  font-size: 28rpx;
}

.counter {
  position: absolute;
  right: 28rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: var(--text-dim);
}

/* 图片九宫格 */
.photos-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.photos-count {
  font-size: 22rpx;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.ph {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--bg-card-2);
}

.ph-img {
  width: 100%;
  height: 100%;
  display: block;
}

.ph-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-dim);
}

.ph-add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--border);
  background: transparent;
}

.ph-add-plus {
  font-size: 56rpx;
  color: var(--text-dim);
  line-height: 1;
}

.ph-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.ph-badge {
  position: absolute;
  left: 6rpx;
  bottom: 6rpx;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #dcdce4;
}

.ph-badge-warn {
  background: rgba(239, 125, 125, 0.85);
  color: #fff;
}

.photos-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 底部 */
.bottom-space {
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border);
}

.btn-del {
  flex: 0 0 180rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--red);
  background: rgba(239, 125, 125, 0.12);
}

.btn-save {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #16161c;
  background: var(--accent);
}

.btn-save.disabled {
  opacity: 0.6;
}
