.page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
}

.map-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

/* 顶部 HUD */
.hud {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  pointer-events: none;
}

.hud .chip {
  pointer-events: auto;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
}

.hud .back {
  color: var(--accent);
}

.hud .title {
  color: var(--text);
  font-weight: 600;
}

/* 操作提示 */
.hint {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(110rpx + env(safe-area-inset-bottom));
  font-size: 22rpx;
  color: var(--text-dim);
  background: rgba(0, 0, 0, 0.28);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  pointer-events: none;
}

/* 图例 */
.legend {
  position: absolute;
  left: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 14rpx 24rpx;
  pointer-events: none;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--text-dim);
}

.swatch {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
}

.s-plain { background: #26262e; border: 1rpx solid #4a5464; }
.s-visited { background: rgba(126, 212, 145, 0.45); border: 1rpx solid #7ed491; }
.s-want { background: rgba(240, 179, 94, 0.45); border: 1rpx solid #f0b35e; }

/* 加载进度条 */
.loadbar {
  position: absolute;
  top: 90rpx;
  left: 24rpx;
  right: 24rpx;
  height: 44rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  overflow: hidden;
}

.loadbar-inner {
  height: 100%;
  background: var(--accent);
  opacity: 0.35;
  transition: width 0.2s;
}

.loadbar-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text);
}

/* 错误提示 */
.error-tip {
  position: absolute;
  top: 90rpx;
  left: 24rpx;
  right: 24rpx;
  background: rgba(239, 125, 125, 0.15);
  border: 1rpx solid var(--red);
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  font-size: 22rpx;
  color: var(--red);
}

/* 标记弹层 */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--bg-card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.sheet-sub {
  margin-bottom: 32rpx;
}

.sheet-btns {
  display: flex;
  gap: 20rpx;
}

.sheet-btn {
  flex: 1;
  text-align: center;
  border-radius: 16rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
  border: 1rpx solid var(--border);
  background: var(--bg-card-2);
  color: var(--text);
}

.s-visited-btn.on {
  color: var(--green);
  border-color: var(--green);
  background: rgba(126, 212, 145, 0.15);
}

.s-want-btn.on {
  color: var(--orange);
  border-color: var(--orange);
  background: rgba(240, 179, 94, 0.15);
}

.s-clear-btn.on {
  color: var(--text-dim);
}

.sheet-hint {
  text-align: center;
  margin-top: 24rpx;
  font-size: 22rpx;
}
