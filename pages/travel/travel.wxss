.page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
}

.map-canvas {
  display: block;
  width: 100%;
  height: 100%;
  background-color: var(--bg); /* canvas 空白期兜底色，避免闪白 */
}

/* 顶部 HUD */
.hud {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  pointer-events: none;
}

.hud .chip {
  pointer-events: auto;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
}

.hud .back {
  color: var(--accent);
}

.hud .title {
  color: var(--text);
  font-weight: 600;
}

.hud .list {
  margin-left: auto;
  color: var(--accent);
}

.hud .my {
  padding: 0;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hud .my-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 操作提示 */
.hint {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  font-size: 22rpx;
  color: var(--text-dim);
  background: rgba(0, 0, 0, 0.28);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  pointer-events: none;
}

/* 覆盖进度 */
.coverage {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(116rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  pointer-events: none;
}

.cov-bar {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.cov-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7ed491, #6ea8fe);
  transition: width 0.3s ease;
}

.cov-text {
  font-size: 20rpx;
  color: var(--text-dim);
  flex-shrink: 0;
}

/* 图例 */
.legend {
  position: absolute;
  left: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 14rpx 24rpx;
  pointer-events: auto;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--text-dim);
}

.legend-item.on {
  color: var(--text);
}

.legend-item.on .swatch {
  box-shadow: 0 0 0 2rpx rgba(110, 168, 254, 0.7);
}

.swatch {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
}

.s-plain { background: #26262e; border: 1rpx solid #4a5464; }
.s-visited { background: rgba(126, 212, 145, 0.45); border: 1rpx solid #7ed491; }
.s-want { background: rgba(240, 179, 94, 0.45); border: 1rpx solid #f0b35e; }

/* 加载进度条 */
.loadbar {
  position: absolute;
  top: 90rpx;
  left: 24rpx;
  right: 24rpx;
  height: 44rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  overflow: hidden;
}

.loadbar-inner {
  height: 100%;
  background: var(--accent);
  opacity: 0.35;
  transition: width 0.2s;
}

.loadbar-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text);
}

/* 错误提示 */
.error-tip {
  position: absolute;
  top: 90rpx;
  left: 24rpx;
  right: 24rpx;
  background: rgba(239, 125, 125, 0.15);
  border: 1rpx solid var(--red);
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  font-size: 22rpx;
  color: var(--red);
}

/* 标记弹层 */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 85vh;
  background: var(--bg-card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 可滚动区：吃掉剩余高度，超出内部滚动 */
.sheet-scroll {
  flex: 1;
  min-height: 0;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.plan-tag {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--orange);
  background: rgba(240, 179, 94, 0.15);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.sheet-sub {
  margin-bottom: 32rpx;
}

.sheet-btns {
  display: flex;
  gap: 20rpx;
}

.sheet-btn {
  flex: 1;
  text-align: center;
  border-radius: 16rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
  border: 1rpx solid var(--border);
  background: var(--bg-card-2);
  color: var(--text);
}

.s-visited-btn.on {
  color: var(--green);
  border-color: var(--green);
  background: rgba(126, 212, 145, 0.15);
}

.s-want-btn.on {
  color: var(--orange);
  border-color: var(--orange);
  background: rgba(240, 179, 94, 0.15);
}

.s-clear-btn.on {
  color: var(--text-dim);
}

.sheet-drill {
  margin-top: 20rpx;
  padding: 26rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--accent);
  background: rgba(110, 168, 254, 0.12);
  border: 1rpx solid rgba(110, 168, 254, 0.4);
  border-radius: 16rpx;
}

.sheet-drill-arrow {
  margin-left: 8rpx;
}

/* 我的回忆 */
.mems {
  margin-top: 28rpx;
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
}

.mems-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.mems-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.mems-count {
  font-size: 22rpx;
}

.mems-body {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mems-thumbs {
  display: flex;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.mems-thumb {
  width: 108rpx;
  height: 108rpx;
  border-radius: 12rpx;
  background: var(--bg-card);
  flex-shrink: 0;
}

.mems-go {
  font-size: 24rpx;
  color: var(--accent);
  flex-shrink: 0;
}

.mems-arrow {
  margin-left: 4rpx;
}

.mems-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 0;
  border: 1rpx dashed var(--border);
  border-radius: 14rpx;
  color: var(--accent);
}

.mems-plus {
  font-size: 34rpx;
  line-height: 1;
}

.mems-empty-text {
  font-size: 26rpx;
}

.sheet-hint {
  text-align: center;
  margin-top: 24rpx;
  font-size: 22rpx;
}

/* ---------- 景点推荐区 ---------- */
.spots {
  margin-top: 28rpx;
  border-top: 1rpx solid var(--border);
  padding-top: 24rpx;
}

.spots-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.spots-title {
  font-size: 28rpx;
  font-weight: 700;
}

.spots-more {
  font-size: 24rpx;
  color: var(--accent);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(110, 168, 254, 0.12);
}

.spots-more.loading {
  color: var(--text-dim);
}

.spots-empty {
  font-size: 24rpx;
  text-align: center;
  padding: 24rpx 0;
}

.spot {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
}

.spot-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.spot-img-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #6ea8fe, #7ed491);
}

.spot-body {
  flex: 1;
  min-width: 0;
}

.spot-line1 {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
}

.spot-name {
  font-size: 28rpx;
  font-weight: 600;
}

.spot-season {
  font-size: 22rpx;
  color: var(--orange);
  flex-shrink: 0;
}

.spot-desc {
  font-size: 24rpx;
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
