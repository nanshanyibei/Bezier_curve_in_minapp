.app {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶栏 */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
  flex-shrink: 0;
}

.topbar-btns {
  display: flex;
  gap: 28rpx;
}

.topbar-btn {
  color: var(--accent);
  font-size: 26rpx;
}

/* 消息区 */
.messages {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.anchor {
  height: 10rpx;
}

.empty {
  text-align: center;
  padding-top: 120rpx;
}

.empty-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.empty-desc {
  margin-bottom: 48rpx;
}

.sug-row {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
}

.sug {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  padding: 14rpx 36rpx;
  color: var(--accent);
  font-size: 26rpx;
}

/* 消息气泡 */
.msg {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-user {
  justify-content: flex-end;
}

.bubble {
  max-width: 82%;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.bubble-user {
  background: var(--accent);
  color: #16161c;
  border-bottom-right-radius: 6rpx;
}

.bubble-ai {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-bottom-left-radius: 6rpx;
}

.invisible {
  opacity: 0;
}

/* 思考折叠 */
.think {
  margin-bottom: 14rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  overflow: hidden;
}

.think-head {
  background: var(--bg-card-2);
  color: var(--text-dim);
  font-size: 22rpx;
  padding: 10rpx 16rpx;
}

.think-body {
  color: var(--text-dim);
  font-size: 24rpx;
  padding: 16rpx;
  white-space: pre-wrap;
}

/* 正文 */
.content {
  white-space: pre-wrap;
  word-break: break-all;
}

/* 光标 */
.caret {
  display: inline-block;
  width: 4rpx;
  height: 30rpx;
  background: var(--accent);
  margin-left: 6rpx;
  vertical-align: middle;
  animation: caret-blink 0.8s infinite;
}

@keyframes caret-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* 三点等待 */
.dots {
  display: flex;
  gap: 10rpx;
  padding: 8rpx 0;
}

.dots view {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
  animation: dot-bounce 1s infinite;
}

.dots view:nth-child(2) { animation-delay: 0.15s; }
.dots view:nth-child(3) { animation-delay: 0.3s; }

@keyframes dot-bounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
  40% { transform: translateY(-10rpx); opacity: 1; }
}

.meta {
  margin-top: 10rpx;
  font-size: 20rpx;
}

/* 输入栏 */
.composer {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  flex-shrink: 0;
  background: var(--bg);
}

.input {
  flex: 1;
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: var(--text);
  max-height: 200rpx;
  box-sizing: border-box;
}

.send-btn,
.stop-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 32rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.modal {
  width: 80%;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 36rpx;
}

.modal-tip {
  margin-bottom: 24rpx;
}

.key-input {
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  color: var(--text);
  font-size: 26rpx;
  margin-bottom: 28rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
}
