/* ===== 自定义编辑页 ===== */
.field-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
}
.field-hint {
  font-size: 22rpx;
  margin-bottom: 10rpx;
}
.field-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx 20rpx;
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  line-height: 1.6;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.emoji-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.emoji-active {
  background: var(--accent-soft);
  border-color: var(--accent);
}

.tag-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.seg-row {
  display: flex;
  background: var(--bg-card-2);
  border-radius: 12rpx;
  overflow: hidden;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--text-dim);
}
.seg-active {
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}

.action-row {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx 40rpx;
}
.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}
.action-btn[disabled] {
  opacity: 0.6;
  background: var(--bg-card-2);
  color: var(--text-dim);
  border: 1rpx solid var(--border);
}
