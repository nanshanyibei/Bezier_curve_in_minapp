/* ===== 详情页 ===== */
.hero-banner {
  height: 360rpx;
  background: linear-gradient(135deg, var(--bg-card-2) 0%, var(--bg-card) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-emoji {
  font-size: 180rpx;
}

.section {
  padding: 32rpx 28rpx 24rpx;
}
.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8rpx;
}
.section-meta {
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
.section-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ingredients {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.ingredient-item {
  font-size: 28rpx;
  color: var(--text);
}

.step-item {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  align-items: flex-start;
}
.step-num {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
}

.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx 10rpx;
}
.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}
.edit-hint {
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
}
