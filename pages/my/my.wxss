.page {
  padding: 32rpx 28rpx 60rpx;
}

.hero {
  padding: 24rpx 8rpx 32rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 24rpx;
}

/* 数据概览 */
.stats-row {
  display: flex;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--accent);
  line-height: 1.2;
  margin-bottom: 6rpx;
}

/* 列表行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-main {
  flex: 1;
}

.row-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.row-arrow {
  color: var(--text-dim);
  font-size: 36rpx;
  margin-left: 16rpx;
}

.footer {
  text-align: center;
  margin-top: 48rpx;
  font-size: 22rpx;
}
