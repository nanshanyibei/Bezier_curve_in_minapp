.page {
  padding: 32rpx 28rpx 60rpx;
}

.hero {
  padding: 24rpx 8rpx 32rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 24rpx;
}

/* 数据概览 */
.stats-row {
  display: flex;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--accent);
  line-height: 1.2;
  margin-bottom: 6rpx;
}

/* 列表行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-main {
  flex: 1;
}

.row-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.row-arrow {
  color: var(--text-dim);
  font-size: 36rpx;
  margin-left: 16rpx;
}

.footer {
  text-align: center;
  margin-top: 48rpx;
  font-size: 22rpx;
}

/* @dev:begin */
/* AI Key 设置弹层（与 assistant 页同源） */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.modal {
  width: 80%;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 36rpx;
}

.modal-tip {
  margin-bottom: 24rpx;
}

.key-input {
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  color: var(--text);
  font-size: 26rpx;
  margin-bottom: 28rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
}
/* @dev:end */
