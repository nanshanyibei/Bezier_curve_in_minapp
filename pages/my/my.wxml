<view class="page">

  <view class="hero">
    <view class="hero-title">南山工作台</view>
    <view class="text-dim hero-sub">旅行足迹 · 云端同步</view>
  </view>

  <!-- 同步状态 -->
  <view class="card row">
    <view class="row-main">
      <view class="row-title">数据同步</view>
      <view class="text-dim">{{syncText}}</view>
    </view>
    <text class="row-arrow" wx:if="{{syncOk}}">✓</text>
  </view>

  <!-- 数据概览 -->
  <view class="stats-row">
    <view class="stats-item">
      <view class="stats-num">{{visitedCount}}</view>
      <view class="text-dim">去过</view>
    </view>
  </view>

  <view class="card row" bindtap="onPrivacy">
    <view class="row-main">
      <view class="row-title">隐私保护指引</view>
      <view class="text-dim">数据如何存储与使用</view>
    </view>
    <text class="row-arrow">›</text>
  </view>

  <view class="card row" bindtap="onAbout">
    <view class="row-main">
      <view class="row-title">关于</view>
      <view class="text-dim">版本与说明</view>
    </view>
    <text class="row-arrow">›</text>
  </view>

  <view class="footer text-dim">v{{version}} · 数据已同步云端</view>
</view>
