.page {
  padding: 24rpx 24rpx 60rpx;
}

.center {
  text-align: center;
  padding: 60rpx 28rpx;
}

.error-text {
  color: var(--red);
  margin-bottom: 24rpx;
  font-size: 26rpx;
}

.overall {
  font-size: 30rpx;
  margin-bottom: 12rpx;
}

.highlight {
  background: var(--accent-soft);
  color: var(--accent);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

/* 情绪条形图 */
.emotion-row {
  display: flex;
  margin-bottom: 20rpx;
}

.emotion-date {
  width: 90rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.emotion-bars {
  flex: 1;
}

.bar-line {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.bar-name {
  width: 64rpx;
  font-size: 20rpx;
  color: var(--text-dim);
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 14rpx;
  background: var(--bg-card-2);
  border-radius: 7rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 7rpx;
}

.bar-val {
  width: 52rpx;
  text-align: right;
  font-size: 20rpx;
  color: var(--text-dim);
  flex-shrink: 0;
}

/* 标签 */
.sub-title {
  color: var(--text-dim);
  font-size: 24rpx;
  margin: 12rpx 0;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  background: var(--bg-card-2);
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
  font-size: 24rpx;
}

.tag.positive { color: var(--green); }
.tag.negative { color: var(--red); }
.tag.neutral  { color: var(--text-dim); }

/* 人生变化 */
.change-item {
  margin-bottom: 24rpx;
}

.change-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.change-name {
  font-weight: 600;
}

.change-dir {
  color: var(--accent);
  font-size: 24rpx;
}

/* AI 发现 */
.finding-item {
  border-top: 1rpx solid var(--border);
  padding: 20rpx 0;
}

.finding-item:first-of-type {
  border-top: none;
  padding-top: 0;
}

.finding-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.finding-type {
  font-size: 20rpx;
  border: 1rpx solid currentColor;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}

.finding-title {
  font-weight: 600;
}

.finding-suggestion {
  color: var(--accent);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.change-line {
  margin-bottom: 8rpx;
  color: var(--text);
  font-size: 26rpx;
}

.raw-toggle {
  text-align: center;
  color: var(--text-dim);
  font-size: 24rpx;
  padding: 20rpx;
}

/* 三点加载动画 */
.loading-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.loading-dots view {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent);
  animation: dot-bounce 1s infinite;
}

.loading-dots view:nth-child(2) { animation-delay: 0.15s; }
.loading-dots view:nth-child(3) { animation-delay: 0.3s; }

@keyframes dot-bounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
  40% { transform: translateY(-12rpx); opacity: 1; }
}
