.outfit-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.body {
  flex: 1;
  height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* 预览 */
.preview-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 16rpx;
  margin-bottom: 28rpx;
}

.preview-box {
  position: relative;
  width: 100%;
  padding-top: 100%;
  height: 0;
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.preview-state {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #9aa5bb;
  font-size: 26rpx;
}

.retry {
  color: var(--accent);
  font-size: 26rpx;
}

.preview-badge {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
}

.preview-tip {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
}

/* 分组 */
.group {
  margin-bottom: 26rpx;
}

.group-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.group-tip {
  font-size: 22rpx;
}

.items-row {
  white-space: nowrap;
  width: 100%;
}

.pick {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 136rpx;
  margin-right: 16rpx;
  vertical-align: top;
}

.pick-thumb {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  background: var(--bg-card-2);
  box-sizing: border-box;
}

.pick-thumb.on {
  border-color: var(--accent);
}

.pick-img {
  width: 100%;
  height: 100%;
  display: block;
}

.pick-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.pick-check {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #16161c;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pick-name {
  width: 100%;
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-dim);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.row-tail {
  display: inline-block;
  width: 8rpx;
  height: 1rpx;
}

.group-empty {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx dashed var(--border);
  border-radius: 16rpx;
  font-size: 24rpx;
}

.link {
  color: var(--accent);
  font-size: 24rpx;
}

.bottom-space {
  height: 32rpx;
}

/* 底部 */
.footer {
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border);
}

.footer-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--accent);
  color: #16161c;
  font-size: 30rpx;
  font-weight: 600;
}

.save-btn.disabled {
  opacity: 0.45;
}

.missing {
  font-size: 22rpx;
}

/* 隐藏画布 */
.work-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 800px;
  height: 800px;
  pointer-events: none;
}
