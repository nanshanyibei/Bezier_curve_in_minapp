.detail-page {
  padding: 28rpx 28rpx 60rpx;
}

.shot {
  position: relative;
  width: 100%;
  padding-top: 100%;
  height: 0;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.shot-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.shot-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b6bfd1;
  font-size: 28rpx;
}

.info {
  padding: 28rpx 4rpx 8rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}

.date {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.section {
  margin-top: 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
}

.section-title {
  padding: 20rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--border);
}

.item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: var(--bg-card-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex: 0 0 auto;
}

.item-body {
  min-width: 0;
  flex: 1;
}

.item-name {
  font-size: 26rpx;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-name.gone {
  color: var(--text-dim);
  text-decoration: line-through;
}

.item-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.bottom-space {
  height: 60rpx;
}

.delete-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  color: var(--red);
  font-size: 28rpx;
}
