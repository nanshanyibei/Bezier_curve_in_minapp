.edit-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.body {
  flex: 1;
  padding: 28rpx 28rpx 0;
  box-sizing: border-box;
}

.field {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  color: var(--text-dim);
}

.inp {
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text);
}

.ph {
  color: var(--text-dim);
}

/* 照片 */
.photo-box {
  display: flex;
}

.photo {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--border);
  background: var(--bg-card-2);
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-dim);
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-style: dashed;
  color: var(--text-dim);
}

.photo-add-plus {
  font-size: 52rpx;
  line-height: 1;
}

.photo-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.photo-badge {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 20rpx;
}

.photo-badge.warn {
  background: rgba(239, 125, 125, 0.85);
}

.photo-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
}

.tip {
  margin-top: 12rpx;
  font-size: 22rpx;
}

/* 处理方式 */
.bg-modes {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

/* 隐藏工作画布（白底/去背景处理用） */
.work-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 800px;
  height: 800px;
  pointer-events: none;
}

/* 选项 chips */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  color: var(--text-dim);
  font-size: 24rpx;
}

.chip.on {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
}

/* 备注 */
.inp-text {
  width: 100%;
  min-height: 160rpx;
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text);
}

.counter {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-dim);
}

.bottom-space {
  height: 40rpx;
}

/* 底部操作 */
.footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border);
}

.btn-del {
  flex: 0 0 160rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--bg-card-2);
  color: var(--red);
  font-size: 28rpx;
}

.btn-save {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--accent);
  color: #16161c;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-save.disabled {
  opacity: 0.6;
}
