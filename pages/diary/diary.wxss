.page {
  padding: 24rpx 24rpx 60rpx;
}

.editor-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.date-chip {
  display: inline-block;
  background: var(--accent-soft);
  color: var(--accent);
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
  font-size: 26rpx;
}

.editor {
  width: 100%;
  min-height: 240rpx;
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text);
}

.save-btn {
  margin-top: 20rpx;
}

.analyze-tip {
  margin-bottom: 20rpx;
}

.analyze-btns {
  display: flex;
  gap: 20rpx;
}

.analyze-btn {
  flex: 1;
}

.stats-row {
  display: flex;
  margin-bottom: 24rpx;
}

.stats-item {
  flex: 1;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  margin-right: 20rpx;
}

.stats-item:last-child {
  margin-right: 0;
}

.stats-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent);
}

.entry-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.entry-date {
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
}

.entry-del {
  color: var(--text-dim);
  font-size: 24rpx;
}

.entry-preview {
  color: var(--text-dim);
  font-size: 26rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
}
