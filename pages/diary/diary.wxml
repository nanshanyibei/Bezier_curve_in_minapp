<view class="page">

  <!-- 写日记 -->
  <view class="card">
    <view class="editor-head">
      <picker mode="date" value="{{selectedDate}}" end="{{today}}" bindchange="onDateChange">
        <view class="date-chip">📅 {{selectedDate}}{{editing ? '（历史）' : ''}} ▾</view>
      </picker>
      <view class="text-dim">{{content.length}} 字</view>
    </view>
    <textarea class="editor" value="{{content}}" bindinput="onInput"
              placeholder="今天发生了什么、想到什么，随手写下来…"
              maxlength="-1" auto-height></textarea>
    <button class="btn save-btn" bindtap="onSave">保存</button>
  </view>

  <!-- AI 分析入口 -->
  <view class="card">
    <view class="card-title">AI 日记分析</view>
    <view class="text-dim analyze-tip">AI 会读取范围内的日记，输出主题、情绪趋势、人生变化与 AI 发现</view>
    <view class="analyze-btns">
      <button class="btn-ghost analyze-btn" data-days="7" bindtap="onAnalyze">近 7 天</button>
      <button class="btn-ghost analyze-btn" data-days="30" bindtap="onAnalyze">近 30 天</button>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats-row">
    <view class="stats-item">
      <view class="stats-num">{{stats.count}}</view>
      <view class="text-dim">总篇数</view>
    </view>
    <view class="stats-item">
      <view class="stats-num">{{stats.chars}}</view>
      <view class="text-dim">总字数</view>
    </view>
  </view>

  <!-- 历史列表 -->
  <view class="card" wx:for="{{entries}}" wx:key="date">
    <view class="entry-head">
      <text class="entry-date">{{item.date}}</text>
      <text class="entry-del" data-date="{{item.date}}" bindtap="onDelete">删除</text>
    </view>
    <view class="entry-preview" data-date="{{item.date}}" bindtap="onPickEntry">{{item.text}}</view>
  </view>

  <view wx:if="{{!entries.length}}" class="text-dim empty-tip">还没有日记，写下第一篇吧</view>
</view>
