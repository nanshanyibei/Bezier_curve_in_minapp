/**
 * 全局主题（深色）与通用样式
 */
page {
  --bg: #16161c;
  --bg-card: #1e1e24;
  --bg-card-2: #26262e;
  --border: #33333d;
  --text: #e8e8ee;
  --text-dim: #8b8b96;
  --accent: #6ea8fe;
  --accent-soft: rgba(110, 168, 254, 0.15);
  --green: #7ed491;
  --orange: #f0b35e;
  --red: #ef7d7d;
  --purple: #b48ef0;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用卡片 */
.card {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.text-dim {
  color: var(--text-dim);
  font-size: 24rpx;
}

/* 通用按钮 */
.btn {
  background: var(--accent);
  color: #16161c;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background: var(--bg-card-2);
  color: var(--accent);
  border-radius: 16rpx;
  font-size: 28rpx;
  border: none;
}

.btn-ghost::after {
  border: none;
}

.btn-danger {
  background: var(--red);
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: none;
}

.btn-danger::after {
  border: none;
}

/* 占位页通用 */
.placeholder-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.placeholder-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.placeholder-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.placeholder-desc {
  color: var(--text-dim);
  font-size: 26rpx;
  text-align: center;
}
